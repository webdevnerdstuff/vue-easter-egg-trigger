{
	"name": "@wdns/vue-easter-egg-trigger",
	"version": "3.0.2",
	"description": "Presenting the Vue Easter Egg Trigger, a tool that discreetly injects a touch of unexpectedness into Vue.js projects. This unassuming plugin, which operates on both keystrokes (with click events also available), brings hidden surprises to your applications.",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/vue-easter-egg-trigger.cjs.js",
	"module": "dist/vue-easter-egg-trigger.es.js",
	"types": "dist/plugin/types/index.d.ts",
	"scripts": {
		"dev": "NODE_OPTIONS='--no-warnings' vite",
		"watch": "pnpm dev",
		"play": "sh src/playground/configs/build.sh && NODE_ENV=playground pnpm dev",
		"build": "vue-tsc -p tsconfig.build.json && vite build --config vite.build.config.mts",
		"build:docs": "vite build",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d docs",
		"prepublishOnly": "npm run build",
		"lint": "eslint \"src/**/*.{ts,vue}\" --max-warnings 4 --no-warn-ignored",
		"prepare": "husky",
		"test:dev": "NODE_OPTIONS='--no-warnings' vitest",
		"test:all": "vitest --run",
		"test:build": "vitest --run --bail 1",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage"
	},
	"lint-staged": {
		"src/**/*.{js,ts,vue}": [
			"npm run lint"
		]
	},
	"author": "WebDevNerdStuff & Bunnies... lots and lots of bunnies! <webdevnerdstuff@gmail.com> (https://webdevnerdstuff.com)",
	"funding": [
		{
			"type": "paypal",
			"url": "https://paypal.me/webdevnerdstuff"
		},
		{
			"type": "patreon",
			"url": "https://www.patreon.com/WebDevNerdStuff"
		}
	],
	"license": "MIT",
	"files": [
		"dist/*",
		"LICENSE.md",
		"README.md"
	],
	"repository": "https://github.com/webdevnerdstuff/vue-easter-egg-trigger",
	"bugs": {
		"url": "https://github.com/webdevnerdstuff/vue-easter-egg-trigger/issues"
	},
	"homepage": "https://github.com/webdevnerdstuff/vue-easter-egg-trigger",
	"keywords": [
		"vue",
		"vue3",
		"javascript",
		"easterEgg",
		"easter egg",
		"easter",
		"egg",
		"eggs",
		"eggs",
		"trigger",
		"webdevnerdstuff",
		"wdns"
	],
	"dependencies": {
		"lodash": "^4.18.1",
		"vue": "^3.3.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fortawesome/fontawesome-svg-core": "^6.7.2",
		"@fortawesome/free-brands-svg-icons": "^6.7.2",
		"@fortawesome/free-regular-svg-icons": "^6.7.2",
		"@fortawesome/free-solid-svg-icons": "^6.7.2",
		"@fortawesome/vue-fontawesome": "^3.3.3",
		"@mdi/font": "^7.4.47",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@stylistic/stylelint-plugin": "^5.3.1",
		"@types/lodash": "^4.17.27",
		"@types/node": "^24.19.4",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vitest/coverage-v8": "^5.1.2",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.6.0",
		"@wdns/eslint-config-wdns": "^2.0.1",
		"@wdns/stylelint-config-wdns": "^2.0.1",
		"@wdns/vue-code-block": "^2.4.1",
		"autoprefixer": "^10.7.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.12.1",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"lint-staged": "^17.6.2",
		"pinia": "^2.3.1",
		"postcss": "^8.5.33",
		"postcss-html": "^1.8.1",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.10.1",
		"prismjs": "^1.30.0",
		"roboto-fontface": "^0.10.0",
		"rollup": "^4.68.8",
		"rollup-plugin-polyfill-node": "^0.13.0",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-scss": "^4.0.1",
		"rollup-plugin-typescript2": "^0.37.0",
		"sass": "^1.108.2",
		"stylelint": "^17.16.0",
		"stylelint-config-recommended-scss": "^17.0.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.3",
		"stylelint-scss": "^7.5.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.74.0",
		"unplugin-auto-import": "^21.1.0",
		"vite": "^6.4.6",
		"vite-plugin-dts": "^5.1.2",
		"vite-plugin-eslint2": "^5.3.0",
		"vite-plugin-stylelint": "^6.4.0",
		"vite-plugin-vuetify": "^2.1.3",
		"vitest": "^5.1.2",
		"vue-tsc": "^3.3.14",
		"vuetify": "^3.13.8",
		"webfontloader": "^1.6.28"
	},
	"packageManager": "pnpm@9.15.9",
	"pnpm": {
		"overrides": {
			"glob@>=9.0.0 <14.0.2": "^14.0.2",
			"minimatch@>=7.0.0 <11.0.1": "^11.0.1"
		}
	}
}
